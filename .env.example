# ============================================================
# Maios Shop – Environment-Vorlage (ROOT / Backend)
# Kopieren:  cp .env.example .env   und mit echten Werten füllen.
# .env selbst NIEMALS committen (siehe .gitignore).
# ============================================================

# ── Laufzeit ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=localhost
SITE_URL=https://maiosshop.com
REPL_URL=
DOMAIN=
SUBDOMAIN=
FULL_URL=

# ── Stripe (SECRET – rotieren falls je geleakt) ──────────────
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CJ_STRIPE_ACCOUNT_ID=

# ── CJ Dropshipping (SECRET) ─────────────────────────────────
CJ_API_BASE_URL=https://developers.cjdropshipping.com
CJ_API_KEY=
CJ_API_SECRET=
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_WAREHOUSE_DE=
CJ_WAREHOUSE_EU=
CJ_WAREHOUSE_US=

# ── E-Mail: Resend (SECRET) ──────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@maiosshop.com
RESEND_FROM_NAME=Maios
FROM_EMAIL=
FROM_NAME=
SUPPORT_EMAIL=
ADMIN_EMAIL=

# ── E-Mail: SMTP-Fallback (SECRET) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Wechselkurse ─────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=

# ── Sicherheit / Sessions (SECRET – zufällig generieren) ─────
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
# Admin-Login (HTTP Basic Auth für Dashboards + /api/cj + Admin-/api/receipt-Routen)
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PANEL_PATH=

# ── Datenbank (aktuell SQLite lokal; diese Felder ungenutzt) ─
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Versand / Shop-Defaults ──────────────────────────────────
FREE_SHIPPING_THRESHOLD=50
SHIPPING_COST_EUROPE=4.99
SHIPPING_COST_INTERNATIONAL=9.99
DELIVERY_TIME_STANDARD=3-5
DELIVERY_TIME_EXPRESS=1-2
DEFAULT_CURRENCY=EUR
DEFAULT_LANGUAGE=de
TIMEZONE=Europe/Berlin

# ── Firmendaten (Impressum/Beleg) ────────────────────────────
# Leer lassen = echte Maios-Defaults aus receipt-generator.js werden genutzt.
COMPANY_NAME=
COMPANY_OWNER=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_COUNTRY=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_WEBSITE=
# Steuernummer fuer den Beleg (Kleinunternehmer hat KEINE USt-IdNr.).
# Pflicht erst bei Rechnungen ueber 250 EUR; bei Kleinbetragsrechnungen optional.
COMPANY_TAX_NUMBER=
# Alt-Name, weiterhin akzeptiert:
COMPANY_TAX_ID=
# Archiv-Postfach fuer die revisionssichere 10-Jahres-Aufbewahrung der Belege
# (Beleg-PDF wird zusaetzlich hierhin gemailt). Default: maioscorporation@gmail.com
RECEIPT_ARCHIVE_EMAIL=

# ── Betriebs-Warnungen ───────────────────────────────────────
# Postfach fuer alle Betriebsmeldungen: gehaeufte Serverfehler UND abgefangene
# unbehandelte Fehler (Absturzschutz). Default: RECEIPT_ARCHIVE_EMAIL
ERROR_ALERT_EMAIL=

# ── Content-Security-Policy ──────────────────────────────────
# Ohne diesen Schalter laeuft die Richtlinie nur im BEOBACHTUNGSMODUS mit:
# der Browser meldet, was sie blocken WUERDE, blockiert aber nichts.
# Erst auf "true" setzen, wenn die Liste unter
# /a29715347575/api/csp-reports nach ein paar Tagen echtem Verkehr leer ist.
CSP_ENFORCE=

# ── HSTS: "diese Seite nur noch verschluesselt aufrufen" ──────
# Wird nur bei verschluesselt eingegangenen Anfragen gesetzt, lokal also nie.
# Standard ohne Eintrag: 86400 (ein Tag). Bewusst kurz — diese Kopfzeile
# laesst sich NICHT zurueckrufen: faellt die Verschluesselung spaeter aus,
# ist der Shop fuer wiederkehrende Besucher genau so lange nicht erreichbar.
# Laeuft es eine Woche ohne Zwischenfall, hier 31536000 (ein Jahr) eintragen —
# das wirkt sofort, ohne Deploy. Werte ueber einem Jahr werden gekappt,
# unsinnige Eintraege fallen auf den Standard zurueck. 0 schaltet ab.
HSTS_MAX_AGE=

# Nur auf ausdruecklichen Wunsch ("true"): gilt dann auch fuer untergeordnete
# Adressen (mail.maiosshop.com o.ae.) — auch fuer solche, die es noch gar
# nicht gibt. Erst setzen, wenn sicher ist, dass jede davon HTTPS kann.
HSTS_INCLUDE_SUBDOMAINS=

# ── Automatische Kontrolllaeufe (alle standardmaessig AUS) ────
# Alle drei laufen nur bei exakt "true". Der manuelle Trigger im Admin-Panel
# funktioniert unabhaengig davon immer.
# Taeglicher Abgleich "bezahlt, aber keine Bestellung" (nur lesend, legt nie
# automatisch eine Bestellung an — meldet nur per Mail).
RECONCILE_ENABLED=
# Postfach fuer diese Warnmeldung. Default: RECEIPT_ARCHIVE_EMAIL
ORDER_ALERT_EMAIL=
# Woechentlicher CJ-Einkaufspreis-Abgleich (aendert nie Verkaufspreise)
CJ_PRICE_SYNC_ENABLED=
CJ_PRICE_ALERT_EMAIL=
# Taeglicher CJ-Bestandsabgleich. Sperrt ein Produkt im Shop nur bei einer
# eindeutigen CJ-Antwort mit Bestand 0 — nie bei Fehlern oder leerer Antwort.
CJ_STOCK_SYNC_ENABLED=
CJ_STOCK_ALERT_EMAIL=
# Taegliches Datenbank-Backup per Mail
DB_BACKUP_ENABLED=

# ── Analytics / Marketing (SECRET wo Token) ──────────────────
GA_TRACKING_ID=
FB_PIXEL_ID=
FACEBOOK_APP_ID=
INSTAGRAM_ACCESS_TOKEN=
TWITTER_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
GOOGLE_MAPS_API_KEY=

# ── Uploads / Bilder ─────────────────────────────────────────
MAX_FILE_SIZE=
ALLOWED_FILE_TYPES=
UPLOAD_PATH=
IMAGE_QUALITY=
IMAGE_MAX_WIDTH=
IMAGE_MAX_HEIGHT=
THUMBNAIL_SIZE=

# ── Cache / Logging / Monitoring ─────────────────────────────
REDIS_URL=
CACHE_TTL=
LOG_LEVEL=info
LOG_FILE=
DEBUG=false
VERBOSE_LOGGING=false
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# ── CORS / HTTPS / Betrieb ───────────────────────────────────
ENABLE_CORS=true
CORS_ORIGIN=https://maiosshop.com
FORCE_HTTPS=true
SSL_CERT_PATH=
SSL_KEY_PATH=
MAINTENANCE_MODE=false
RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX_REQUESTS=
BACKUP_SCHEDULE=
BACKUP_RETENTION_DAYS=

# ── Webhooks (intern) ────────────────────────────────────────
WEBHOOK_ORDER_CREATED=
WEBHOOK_PAYMENT_SUCCESS=
WEBHOOK_SHIPPING_UPDATE=

# ── Lokale Video-/TikTok-Render-Defaults (auch in Marketing) ─
VIDEO_RENDER_BACKEND=
LOCAL_VIDEO_DEVICE=
LOCAL_VIDEO_MODEL_ID=
LOCAL_VIDEO_STEPS=
LOCAL_VIDEO_GUIDANCE=
LOCAL_VIDEO_FRAMES=
TIKTOK_CHROMEDRIVER=
TIKTOK_CHROME_PROFILE=
